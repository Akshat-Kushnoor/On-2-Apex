# App Settings
PROJECT_NAME="AI Placement Coach"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
LOG_LEVEL="INFO"

# Security & Authentication
SECRET_KEY="placement-coach-super-secret-development-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite local file in root db/)
DATABASE_URL="sqlite:///../db/placement_coach.db"

# CORS (Frontend Next.js URLs)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI Gateway Key & Ollama Endpoint
OPENAI_KEY=
OLLAMA_BASE_URL="http://localhost:11434"

# Google Integration (OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/google/oauth2/callback"